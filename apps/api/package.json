{
  "name": "transport-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "local": "bun --env-file=../../.env --watch src/index.ts",
    "local:setup": "bun --env-file=../../.env run db:push && bun --env-file=../../.env run seed",
    "start": "bun src/index.ts",
    "seed": "bun src/db/seed.ts",
    "test": "bun test src",
    "test:e2e": "bun --env-file=../../.env scripts/e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "hono": "^4.9.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.0",
    "@hono/zod-validator": "^0.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0"
  }
}
