# Plantilla de variables de entorno.
# Copiar a `.env` (que git ignora) y reemplazar los valores:
#   cp .env.template .env
# Nunca subir `.env` al repositorio.

# --- PostgreSQL ---------------------------------------------------------
# Credenciales del contenedor de base de datos. La API se conecta con ellas.
POSTGRES_USER=transport
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=transport

# --- API ----------------------------------------------------------------
# Clave con la que se firman los JWT. Debe ser larga y aleatoria. Generar con:
#   openssl rand -base64 48
JWT_SECRET=cambiar-esto

# Origen del frontend permitido por CORS.
WEB_ORIGIN=http://localhost:3000

# Solicitudes de reunión permitidas por IP y por hora desde la sala de ventas.
# 0 desactiva el límite; sin esta variable, la API fuera de Docker usa 10.
# MEETING_RATE_LIMIT=0

# Solo si ejecuta la API fuera de Docker (bun run local): la base de datos se publica en localhost
# y la API arma la conexión con las variables POSTGRES_*. Otro servidor: POSTGRES_HOST=...
# POSTGRES_HOST=localhost

# Contraseña de los usuarios demo que crea el seed
# (dueno@transport.gt, gerente@transport.gt, etc.). Solo para desarrollo.
SEED_PASSWORD=cambiar-esto

# --- Web ----------------------------------------------------------------
# URL pública de la API tal como la ve el navegador.
NEXT_PUBLIC_API_URL=http://localhost:4000
